{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["WebWorker", "WebWorker.ImportScripts", "ES2020"],
    "types": [],
    "strict": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/sw.ts"],
  "exclude": ["node_modules"]
}

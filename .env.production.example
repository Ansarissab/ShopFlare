# Production frontend build vars — copy to `.env.production` and fill in.
#
# These NEXT_PUBLIC_* values are PUBLIC (compiled into the client bundle by
# `pnpm web:deploy`) — they are not secrets, but they are deployment-specific, so
# `.env.production` is gitignored. Worker SECRETS (Stripe, Resend, ADMIN_*, etc.)
# never go here — they live in `wrangler secret put`.
#
# These are read only when NODE_ENV=production (the web:deploy build), so they
# cannot affect local `next dev`.
NEXT_PUBLIC_WORKER_URL=https://shopflare-worker.YOUR-SUBDOMAIN.workers.dev
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA_your_site_key
NEXT_PUBLIC_SITE_URL=https://shopflare-web.YOUR-SUBDOMAIN.workers.dev

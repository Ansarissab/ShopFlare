# Next.js public env vars (safe to commit — these are .example only)
# Copy to .env.local and fill in your values

# Cloudflare Worker URL (your deployed worker)
NEXT_PUBLIC_WORKER_URL=https://singlepage-ecomm-worker.YOUR-SUBDOMAIN.workers.dev


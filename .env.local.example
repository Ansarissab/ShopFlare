# Next.js public env vars (safe to commit — these are .example only)
# Copy to .env.local and fill in your values

# Cloudflare Worker URL (your deployed worker)
NEXT_PUBLIC_WORKER_URL=https://shopflare-worker.YOUR-SUBDOMAIN.workers.dev

# Cloudflare Turnstile site key — REQUIRED. Read at build time by TurnstileWidget;
# without it the COD form's submit button stays disabled.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA_your_site_key

# Public site URL — used by sitemap.ts to emit absolute product URLs.
# Must match your Cloudflare Pages domain (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://your-store.example.com

# Stripe publishable key — optional. The current Checkout flow redirects via the
# Worker, so client-side Stripe.js is not needed unless you add it.
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

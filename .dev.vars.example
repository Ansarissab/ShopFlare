# Admin API auth (worker verifies the CF Access assertion JWT). Leave blank in
# local dev (ENVIRONMENT=development bypasses verification). In production set:
#   CF_ACCESS_TEAM_DOMAIN — your Zero Trust team domain, no scheme
#   CF_ACCESS_AUD         — the Audience (AUD) tag of the admin-API Access app
CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
CF_ACCESS_AUD=...

{
  "name": "shopflare",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "next dev",
    "dev:all": "concurrently -k -n web,worker -c cyan,magenta \"pnpm dev\" \"pnpm worker:dev\"",
    "dev:setup": "pnpm db:migrate:local && pnpm db:seed:local",
    "dev:fresh": "pnpm dev:setup && pnpm dev:all",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && tsc -p worker/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "setup": "node scripts/setup/index.mts",
    "worker:dev": "wrangler dev worker/index.ts",
    "worker:deploy": "wrangler deploy --var ENVIRONMENT:production",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply store-db --local",
    "db:migrate": "wrangler d1 migrations apply store-db --remote",
    "db:seed:local": "wrangler d1 execute store-db --local --file=worker/db/seed.sql",
    "db:seed": "wrangler d1 execute store-db --remote --file=worker/db/seed.sql"
  },
  "dependencies": {
    "@base-ui/react": "1.5.0",
    "@clack/prompts": "^1.5.0",
    "@hookform/resolvers": "^5.4.0",
    "@stripe/stripe-js": "^9.7.0",
    "browser-image-compression": "^2.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "embla-carousel-react": "^8.6.0",
    "hono": "^4.12.23",
    "lucide-react": "^1.17.0",
    "nanoid": "^5.1.11",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.77.0",
    "recharts": "^3.8.1",
    "resend": "^6.12.4",
    "sonner": "^2.0.7",
    "stripe": "^22.2.0",
    "tailwind-merge": "^3.6.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.12.21",
    "@cloudflare/workers-types": "^4.20260531.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "3.2.6",
    "concurrently": "^10.0.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4",
    "wrangler": "^4.95.0"
  }
}

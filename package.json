{
  "name": "shopflare",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "next dev",
    "dev:all": "concurrently -k -n web,worker -c cyan,magenta \"pnpm dev\" \"pnpm worker:dev\"",
    "dev:setup": "pnpm db:migrate:local && pnpm db:seed:local",
    "dev:fresh": "pnpm dev:setup && pnpm dev:all",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build --turbopack",
    "build:webpack": "NEXT_TELEMETRY_DISABLED=1 next build --webpack",
    "start": "next start",
    "web:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview -c wrangler.frontend.jsonc",
    "web:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy -c wrangler.frontend.jsonc",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsgo --noEmit && tsgo -p worker/tsconfig.json --noEmit && tsgo -p tsconfig.sw.json --noEmit",
    "typecheck:tsc": "tsc --noEmit && tsc -p worker/tsconfig.json --noEmit && tsc -p tsconfig.sw.json --noEmit",
    "test": "vitest run --project unit && vitest run --project integration",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:changed": "vitest run --project unit --changed --passWithNoTests",
    "test:coverage": "vitest run --project unit --coverage",
    "test:integration": "vitest run --project integration",
    "test:e2e": "node scripts/e2e.mjs --project=chromium-desktop",
    "test:e2e:full": "node scripts/e2e.mjs",
    "test:smoke": "node scripts/e2e.mjs --grep @smoke",
    "test:visual": "node scripts/e2e.mjs e2e/visual.spec.ts --workers=1",
    "test:visual:update": "node scripts/e2e.mjs e2e/visual.spec.ts --workers=1 --update-snapshots",
    "test:visual:docker": "docker build -t shopflare-visual e2e && docker run --rm -v $PWD/.visual-baselines:/work/.visual-baselines shopflare-visual",
    "test:e2e:ui": "node scripts/e2e.mjs --ui",
    "test:all": "pnpm test:coverage && pnpm test:integration && pnpm test:e2e:full",
    "verify": "node scripts/ci.mjs",
    "ci": "node scripts/ci.mjs",
    "setup": "node scripts/setup/index.mts",
    "worker:dev": "wrangler dev worker/index.ts",
    "worker:deploy": "wrangler deploy --var ENVIRONMENT:production",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply shopflare-db0 --local",
    "db:migrate": "wrangler d1 migrations apply shopflare-db0 --remote",
    "db:seed:local": "wrangler d1 execute shopflare-db0 --local --file=worker/db/seed.sql",
    "db:seed": "wrangler d1 execute shopflare-db0 --remote --file=worker/db/seed.sql",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@base-ui/react": "1.5.0",
    "@clack/prompts": "^1.5.0",
    "@hookform/resolvers": "^5.4.0",
    "@opennextjs/cloudflare": "^1.19.11",
    "@stripe/stripe-js": "^9.7.0",
    "browser-image-compression": "^2.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "embla-carousel-react": "^8.6.0",
    "fuse.js": "^7.4.1",
    "hono": "^4.12.23",
    "isomorphic-dompurify": "^3.16.0",
    "lucide-react": "^1.17.0",
    "nanoid": "^5.1.11",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.77.0",
    "recharts": "^3.8.1",
    "resend": "^6.12.4",
    "serwist": "^9.5.11",
    "shadcn": "4.9.0",
    "sonner": "^2.0.7",
    "stripe": "^22.2.0",
    "tailwind-merge": "^3.6.0",
    "trix": "^2.1.19",
    "tw-animate-css": "1.4.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@cloudflare/vitest-pool-workers": "^0.12.21",
    "@cloudflare/workers-types": "^4.20260531.1",
    "@playwright/test": "^1.60.0",
    "@serwist/next": "^9.5.11",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript/native-preview": "7.0.0-dev.20260609.1",
    "@vitest/coverage-v8": "3.2.6",
    "concurrently": "^10.0.3",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^29.1.1",
    "nano-staged": "^1.0.2",
    "oxfmt": "^0.54.0",
    "oxlint": "^1.69.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4",
    "wrangler": "^4.95.0"
  }
}

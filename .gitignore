# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report
/.playwright
/.visual-baselines
/e2e/**/*-snapshots

# next.js
/.next/
/out/

# OpenNext (Cloudflare adapter build output)
/.open-next/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — ignore secrets/overrides, but commit the non-secret local defaults.
.env*
!.env*.example
# Committed local-dev defaults (localhost only, NO secrets). Keeps `next dev`
# pointed at the local worker so it never touches production.
!.env.development

# Cloudflare Workers local secrets
.dev.vars

# vercel
.vercel

# typescript
*.tsbuildinfo
.tscache/
next-env.d.ts

# Cloudflare local state
.wrangler/

# PWA — service worker is generated by Serwist at build time
/public/sw.js
/public/sw.js.map

# TWA Android signing key — NEVER commit
/packaging/twa/*.keystore
/packaging/twa/*.jks

# graphify knowledge graph outputs (cache + generated files)
**/graphify-out
**/packaging

**/.tmp_test/*
**/.tmpcov/*
**/.tmp-cov/*

# Maintainer local wrangler override (keeps real resource ids out of git)
wrangler.local.toml
.gstack/
lighthouse_results/

# Local portfolio / job-application source (lives on gh-pages branch, not main)
/portfolio/

# Local development defaults — COMMITTED, and intentionally contains NO secrets.
#
# Loaded only by `next dev` (NODE_ENV=development). It pins the storefront to the
# LOCAL worker so local development never reads or writes production data.
#
# Do NOT put production URLs or any secret here. Production build values go in
# .env.production (gitignored; see .env.production.example). Worker secrets go in
# .dev.vars (local) / `wrangler secret put` (prod).
NEXT_PUBLIC_WORKER_URL=http://localhost:8787
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Turnstile site key is omitted on purpose — the widget falls back to Cloudflare's
# always-passing test key in development.

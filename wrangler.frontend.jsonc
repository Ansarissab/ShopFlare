{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Frontend SSR worker (Next.js via OpenNext). Separate from the API worker
  // (wrangler.toml = shopflare-worker). This one serves the site + RSC/SSR and
  // talks to the API worker over HTTP via NEXT_PUBLIC_WORKER_URL.
  "name": "shopflare-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-05-31",
  // global_fetch_strictly_public: REQUIRED. This worker fetches the API worker
  // (shopflare-worker) which lives on the same *.workers.dev zone. Without this
  // flag a same-zone Worker→Worker subrequest fails on the edge with error 1042
  // ("Worker tried to fetch from another Worker on the same zone"), so every SSR
  // data fetch threw → notFound() on every page. The flag forces fetch() to route
  // strictly over the public internet, so it reaches the API worker normally.
  // (Local `preview`/`dev` workerd doesn't enforce this, which is why it only bit
  // the deployed worker.) See https://developers.cloudflare.com/workers/observability/errors/
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Service binding to the API worker — an INTERNAL worker→worker call (no public
  // round-trip), which fetchFromWorker prefers over the public fetch to cut SSR TTFB.
  // The public fetch (enabled by global_fetch_strictly_public above) stays as the
  // fallback for when the binding is absent/unavailable (local `next dev`, build-time
  // static generation, or a preview without the API worker running). Service name must
  // match the API worker's `name` in wrangler.toml / wrangler.prod.toml.
  "services": [{ "binding": "API", "service": "shopflare-worker" }],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
}

{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-pool-workers"],
    "paths": {
      "@/*": ["../src/*"],
      "worker/*": ["./*"]
    }
  },
  "include": [
    "**/*.ts",
    "../src/lib/schemas/**/*.ts",
    "../src/lib/constants/**/*.ts"
  ],
  "exclude": ["node_modules"]
}

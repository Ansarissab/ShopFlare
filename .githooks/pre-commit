#!/usr/bin/env sh
# Fast gate only — lint/format staged files, then typecheck (frontend + worker).
# Tests moved to pre-push: commits are frequent and the suite is slow/growing.
# Run the full suite manually anytime with `pnpm test`.

# Lint + format ONLY the staged files (oxlint --fix then oxfmt, re-staged on fix).
# Encodes the lint/format rules as tooling so they can't be forgotten — fails the
# commit on oxlint errors (warnings pass). Configs: .nano-staged.json,
# .oxlintrc.json, .oxfmtrc.json (style matches the repo: no semicolons, single
# quotes). Whole-repo formatting is still available via `pnpm format`.
echo "[pre-commit] lint+format staged files (nano-staged → oxlint --fix, oxfmt)..."
./node_modules/.bin/nano-staged || exit 1

echo "[pre-commit] typecheck (frontend + worker) — parallel (tsgo)..."

npx tsgo --noEmit 2>&1 | sed 's/^/[tsgo:app]  /' &
TC1=$!
npx tsgo -p worker/tsconfig.json --noEmit 2>&1 | sed 's/^/[tsgo:work] /' &
TC2=$!

S1=0; S2=0
wait $TC1 || S1=$?
wait $TC2 || S2=$?

[ $S1 -ne 0 ] && echo "[pre-commit] FAIL: frontend typecheck"
[ $S2 -ne 0 ] && echo "[pre-commit] FAIL: worker typecheck"

[ $S1 -eq 0 ] && [ $S2 -eq 0 ]

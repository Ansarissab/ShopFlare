#!/usr/bin/env bash
# Strip AI/tool attribution TRAILER lines from the commit message.
# Commits must read as the author's own work — no "Generated with Claude Code",
# no "Co-authored-by: …" trailers. Runs on every commit (core.hooksPath=.githooks).
#
# Patterns are anchored to the start of a line (after optional whitespace / the
# robot emoji) so ordinary prose that merely mentions these phrases is preserved
# — only lines that ARE the trailer get removed.
set -euo pipefail

msg_file="$1"

grep -v -E '^[[:space:]]*(🤖[[:space:]]*)?Generated with \[?Claude Code|^[[:space:]]*Co-authored-by:' "$msg_file" \
  | awk '{ a[NR]=$0 } END { e=NR; while (e>0 && a[e] ~ /^[[:space:]]*$/) e--; for (i=1;i<=e;i++) print a[i] }' \
  > "$msg_file.cleaned"

mv "$msg_file.cleaned" "$msg_file"
